{
  "name": "my-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "node scripts/predeploy.mjs && npm run check-demos && npm run lint && npm run build && wrangler pages deploy dist --project-name jayasaikishore --branch main && npm run smoke -- --expect-dist",
    "check-demos": "node scripts/check-demos.mjs",
    "smoke": "node scripts/smoke.mjs",
    "screens": "node scripts/screens.mjs",
    "og-image": "node scripts/og-image.mjs"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.56.1",
    "vite": "^8.3.0",
    "wrangler": "4.164.0"
  }
}
